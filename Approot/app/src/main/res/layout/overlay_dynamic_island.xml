<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/islandMasterRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- PRIMARY CONTEXT PILL COMPONENT -->
        <RelativeLayout
            android:id="@+id/islandBasePill"
            android:layout_width="110dp"
            android:layout_height="30dp"
            android:background="@android:color/black"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipChildren="false">

            <!-- COMPACT VIEW ONLY LAYOUT SECTOR -->
            <ImageView
                android:id="@+id/islandLeftIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:src="@android:drawable/ic_menu_compass"
                android:visibility="gone"/>

            <FrameLayout
                android:id="@+id/islandRightActionArea"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true">
                <Chronometer
                    android:id="@+id/islandCallChronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textColor="#34C759"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
                <LinearLayout
                    android:id="@+id/islandVisualizerGroup"
                    android:layout_width="22dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <View android:id="@+id/waveBar1" android:layout_width="2.5dp" android:layout_height="8dp" android:background="#1DB954" android:layout_marginEnd="1.5dp"/>
                    <View android:id="@+id/waveBar2" android:layout_width="2.5dp" android:layout_height="14dp" android:background="#1DB954" android:layout_marginEnd="1.5dp"/>
                    <View android:id="@+id/waveBar3" android:layout_width="2.5dp" android:layout_height="11dp" android:background="#1DB954" android:layout_marginEnd="1.5dp"/>
                    <View android:id="@+id/waveBar4" android:layout_width="2.5dp" android:layout_height="6dp" android:background="#1DB954"/>
                </LinearLayout>
            </FrameLayout>

            <!-- ================================================================= -->
            <!-- EXPANDED NOTIFICATION & INCOMING INTERACTIVE CALL INTERFACE CORE -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/islandExpandedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_centerInParent="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Heading Row: App Icon & Call/Message Sender Profile Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:id="@+id/islandExpandedAppIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_call"/>
                        
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:id="@+id/islandExpandedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="John Doe"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/islandExpandedSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WhatsApp Voice Call"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Action Button Matrix: Call Accept/Decline (Hidden for pure text messages) -->
                <LinearLayout
                    android:id="@+id/islandActionButtonsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <!-- Decline Button: Crimson Rounded Capsule Shape -->
                    <TextView
                        android:id="@+id/btnIslandDecline"
                        android:layout_width="74dp"
                        android:layout_height="32dp"
                        android:background="@android:drawable/presence_offline"
                        android:backgroundTint="#FF3B30"
                        android:gravity="center"
                        android:text="Decline"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10dp"/>

                    <!-- Answer Button: Emerald Green Rounded Capsule Shape -->
                    <TextView
                        android:id="@+id/btnIslandAnswer"
                        android:layout_width="74dp"
                        android:layout_height="32dp"
                        android:background="@android:drawable/presence_offline"
                        android:backgroundTint="#34C759"
                        android:gravity="center"
                        android:text="Answer"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

        <!-- DUAL-ACTIVITY MULTITASK BUBBLE -->
        <FrameLayout
            android:id="@+id/islandSplitBubble"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/black"
            android:visibility="gone">
            <ImageView
                android:id="@+id/islandSplitIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_alert"/>
        </FrameLayout>

    </LinearLayout>
</FrameLayout>
