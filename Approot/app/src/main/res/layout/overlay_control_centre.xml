<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:id="@+id/ccRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:paddingTop="60dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Grid Container Layout Positioning -->
    <GridLayout
        android:id="@+id/ccGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <!-- POD 1: Network Toggles (Top Left) -->
        <GridLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_ios_pod"
            android:padding="16dp"
            android:columnCount="2"
            android:rowCount="2">
            
            <ImageView
                android:id="@+id/toggleWifi"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="6dp"
                android:background="@android:color/holo_blue_dark"
                android:padding="14dp"
                android:src="@android:drawable/ic_dialog_info"/>

            <ImageView
                android:id="@+id/toggleBluetooth"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="6dp"
                android:background="@android:color/holo_blue_dark"
                android:padding="14dp"
                android:src="@android:drawable/ic_dialog_info"/>
        </GridLayout>

        <!-- POD 2: Sliders Grid Pod (Top Right) -->
        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_ios_pod"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp">

            <com.replica.iosui.views.IOSSliderView
                android:id="@+id/ccBrightness"
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"/>

            <com.replica.iosui.views.IOSSliderView
                android:id="@+id/ccVolume"
                android:layout_width="54dp"
                android:layout_height="match_parent"/>
        </LinearLayout>
        
    </GridLayout>
</RelativeLayout>
