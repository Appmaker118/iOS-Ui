<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. SYSTEM CONTROL CENTRE INJECTABLE SLIDING TRAY -->
    <RelativeLayout
        android:id="@+id/ccRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:paddingTop="80dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone"
        android:clipChildren="false">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:clipChildren="false">

            <GridLayout
                android:id="@+id/ccGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true"
                android:alignmentMode="alignBounds">

                <!-- POD 1: Network Toggles Matrix -->
                <GridLayout
                    android:layout_width="165dp"
                    android:layout_height="165dp"
                    android:background="@drawable/bg_ios_pod"
                    android:padding="12dp"
                    android:columnCount="2"
                    android:rowCount="2">
                    <ImageView android:id="@+id/ccWifi" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#444444" android:padding="16dp" android:src="@android:drawable/ic_menu_info_details"/>
                    <ImageView android:id="@+id/ccBluetooth" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#007AFF" android:padding="16dp" android:src="@android:drawable/ic_menu_compass"/>
                    <ImageView android:id="@+id/ccCellular" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#444444" android:padding="16dp" android:src="@android:drawable/ic_menu_mylocation"/>
                    <ImageView android:id="@+id/ccAirplane" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="8dp" android:background="#444444" android:padding="16dp" android:src="@android:drawable/ic_menu_send"/>
                </GridLayout>

                <!-- POD 2: Display & Audio Sliders Block -->
                <LinearLayout
                    android:layout_width="165dp"
                    android:layout_height="165dp"
                    android:background="@drawable/bg_ios_pod"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="14dp">
                    <com.replica.iosui.views.IOSSliderView android:id="@+id/ccBrightness" android:layout_width="58dp" android:layout_height="match_parent" android:layout_marginEnd="14dp"/>
                    <com.replica.iosui.views.IOSSliderView android:id="@+id/ccVolume" android:layout_width="58dp" android:layout_height="match_parent"/>
                </LinearLayout>

                <!-- POD 3: Quick Utilities Stack (Flashlight) -->
                <GridLayout
                    android:layout_width="165dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_ios_pod"
                    android:padding="8dp"
                    android:columnCount="2">
                    <ImageView android:id="@+id/ccFlashlight" android:layout_width="54dp" android:layout_height="54dp" android:layout_margin="4dp" android:background="#444444" android:padding="14dp" android:src="@android:drawable/btn_star_big_off"/>
                </GridLayout>

                <!-- POD 4: Media Playback Block -->
                <LinearLayout
                    android:layout_width="165dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_ios_pod"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/ccTrackTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Not Playing"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                    <ImageView
                        android:id="@+id/ccMediaPlayPause"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_media_play"/>
                </LinearLayout>

            </GridLayout>
        </ScrollView>
    </RelativeLayout>

    <!-- 2. NATIVE STATUS BAR FRAME LAYOUT OVERRIDE -->
    <RelativeLayout
        android:id="@+id/statusBarContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#FF000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_gravity="top">

        <TextView
            android:id="@+id/statusBarTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="9:41"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statusBarSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5G"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:textStyle="bold"/>

            <RelativeLayout
                android:id="@+id/batteryContainer"
                android:layout_width="24dp"
                android:layout_height="12dp"
                android:background="@drawable/ios_battery_shape">
                <View
                    android:id="@+id/batteryLevelFill"
                    android:layout_width="16dp"
                    android:layout_height="match_parent"
                    android:layout_margin="1.5dp"
                    android:background="@drawable/ios_battery_fill"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- 3. VOLUMETRIC SIDE INTERACTIVEHUD INTERFACE CONTAINER -->
    <LinearLayout
        android:id="@+id/hudContainer"
        android:layout_width="wrap_content"
        android:layout_height="140dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="12dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clipChildren="false">
        <com.replica.iosui.views.IOSSliderView
            android:id="@+id/hudSlider"
            android:layout_width="14dp"
            android:layout_height="match_parent"/>
    </LinearLayout>

</FrameLayout>
