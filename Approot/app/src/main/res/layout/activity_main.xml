<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E"
    android:padding="24dp">

    <!-- Control Center Grid Pod Container Layout Placement -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#2C2C2E"
        android:padding="20dp"
        android:orientation="horizontal">

        <!-- Brightness Target UI Slider -->
        <com.replica.iosui.views.IOSSliderView
            android:id="@+id/brightnessSlider"
            android:layout_width="72dp"
            android:layout_height="148dp"
            android:layout_marginEnd="20dp" />

        <!-- Volume Target UI Slider -->
        <com.replica.iosui.views.IOSSliderView
            android:id="@+id/volumeSlider"
            android:layout_width="72dp"
            android:layout_height="148dp" />

    </LinearLayout>

</RelativeLayout>
