<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. CANVAS WALLPAPER -->
    <ImageView
        android:id="@+id/launcherWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@android:drawable/sym_def_app_icon"/>

    <!-- 2. HOME WORKSPACE VIEW PAGES -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="110dp"
        android:clipChildren="false"
        android:clipToPadding="false"/>

    <!-- 3. CONFIGURATION CALIBRATION SLIDER & SWITCH OVERLAY PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="60dp"
        android:background="#E61C1C1E"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="10dp">
        
        <!-- Live Position Calibrator Sliders -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Island X Offset" android:textColor="#FFF" android:textStyle="bold"/>
        <SeekBar android:id="@+id/sliderX" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1000" android:layout_marginBottom="8dp"/>
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Island Y Offset" android:textColor="#FFF" android:textStyle="bold"/>
        <SeekBar android:id="@+id/sliderY" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="300" android:layout_marginBottom="16dp"/>

        <!-- THE SYSTEM DEFAULT LAUNCHER TOGGLE SWITCH BUTTON -->
        <Button
            android:id="@+id/btnToggleLauncher"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Switch Default Home App"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#007AFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"/>
            
    </LinearLayout>

    <!-- 4. DOT INDICATORS -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/pageIndicatorDots"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="122dp"
        android:background="@android:color/transparent"
        app:tabBackground="@android:drawable/radiobutton_off_background"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@android:color/transparent"/>

    <!-- 5. FLOATING FROSTED DOCK -->
    <LinearLayout
        android:id="@+id/iosDockShelf"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_ios_dock"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4"
        android:clipChildren="false"
        android:layerType="hardware"/>

</RelativeLayout>
