<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. SYSTEM DESKTOP WALLPAPER -->
    <ImageView
        android:id="@+id/launcherWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@android:drawable/sym_def_app_icon"/>

    <!-- 2. HORIZONTAL PAGES CONTAINER -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="110dp"
        android:clipChildren="false"
        android:clipToPadding="false"/>

    <!-- 3. CLASSIC iOS DOT PAGE INDICATORS -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/pageIndicatorDots"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="115dp"
        android:background="@android:color/transparent"
        app:tabBackground="@android:drawable/radiobutton_off_background"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@android:color/transparent"/>

</RelativeLayout>
