<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false">

    <!-- 1. CANVAS WALLPAPER LAYER -->
    <ImageView
        android:id="@+id/lockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@android:drawable/sym_def_app_icon" />

    <!-- 2. CLOCK MATRIX CLUSTER -->
    <LinearLayout
        android:id="@+id/lockClockGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lockDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FRIDAY, 6 NOVEMBER"
            android:textColor="#E5FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/lockClockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:41"
            android:textColor="#FFFFFF"
            android:textSize="84sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"/>
    </LinearLayout>

    <!-- 3. QUICK ACTION UTILITY BUTTONS -->
    <!-- Flashlight (Bottom Left) -->
    <ImageView
        android:id="@+id/lockFlashlight"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="50dp"
        android:layout_marginStart="46dp"
        android:background="@drawable/bg_ios_lock_button"
        android:padding="14dp"
        android:src="@android:drawable/btn_star_big_off"
        android:scaleType="centerInside"
        android:elevation="4dp"/>

    <!-- Camera Launch (Bottom Right) -->
    <ImageView
        android:id="@+id/lockCamera"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="50dp"
        android:layout_marginEnd="46dp"
        android:background="@drawable/bg_ios_lock_button"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_camera"
        android:scaleType="centerInside"
        android:elevation="4dp"/>

    <!-- 4. BOTTOM HOME GRABBER LINE -->
    <LinearLayout
        android:id="@+id/lockBottomHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="15dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swipe up to unlock"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="140dp"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:backgroundTint="#FFFFFF"/>
    </LinearLayout>

</RelativeLayout>
